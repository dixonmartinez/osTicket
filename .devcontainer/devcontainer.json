{
  // ---------------------------------------------------------------------
  // Dev Container de osTicket.
  //
  // VS Code: F1 → "Dev Containers: Reopen in Container"
  //   (o el aviso "Reopen in Container" que aparece al abrir el proyecto)
  //
  // El contenedor que editas es el MISMO que sirve la aplicación: al
  // guardar un archivo el cambio es inmediato y Xdebug conecta sin
  // configuración adicional.
  // ---------------------------------------------------------------------
  "name": "osTicket (dev)",

  "dockerComposeFile": [
    "../compose.yaml",
    "../compose.override.yaml",
    "./compose.debug.yaml"
  ],
  "service": "php",
  "workspaceFolder": "/var/www/html",
  "shutdownAction": "stopCompose",

  // nginx publica 8080 en el host; el resto son servicios de apoyo
  "forwardPorts": [8080, 8025, 3307, 9003],
  "portsAttributes": {
    "8080": { "label": "osTicket", "onAutoForward": "openPreview" },
    "8025": { "label": "Mailpit (correo de pruebas)", "onAutoForward": "silent" },
    "3307": { "label": "MariaDB", "onAutoForward": "silent" },
    "9003": { "label": "Xdebug", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "xdebug.php-debug",
        "bmewburn.vscode-intelephense-client",
        "neilbreatnham.composer",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql",
        "EditorConfig.EditorConfig",
        "redhat.vscode-yaml",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "humao.rest-client"
      ],
      "settings": {
        "php.validate.executablePath": "/usr/local/bin/php",
        "intelephense.environment.phpVersion": "8.4.0",
        "intelephense.files.exclude": [
          "**/include/mpdf/**",
          "**/include/laminas-mail/**",
          "**/include/pear/**",
          "**/include/fpdf/**",
          "**/vendor/**",
          "**/node_modules/**"
        ],
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false,
        "terminal.integrated.defaultProfile.linux": "sh",
        "sqltools.connections": [
          {
            "name": "osTicket (dev)",
            "driver": "MariaDB",
            "server": "db",
            "port": 3306,
            "database": "osticket",
            "username": "osticket",
            "password": "osticket"
          }
        ]
      }
    }
  },

  // Instala la CLI de Composer (sólo para las herramientas de desarrollo:
  // el runtime de osTicket no usa Composer).
  // Comprobación de arranque: versión de PHP y estado de php2shell
  "postCreateCommand": "php -v && php tools/security/php-cve-check.php || true",

  "remoteUser": "root"
}
