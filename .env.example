# ---------------------------------------------------------------------------
# Variables del entorno Docker.
#
#   cp .env.example .env
#   # IMPORTANTE: genera una sal aleatoria
#   sed -i "s|^OST_SECRET_SALT=.*|OST_SECRET_SALT=$(openssl rand -hex 32)|" .env
#
# El archivo .env está en .gitignore: contiene credenciales.
# ---------------------------------------------------------------------------

# --- Versión de PHP --------------------------------------------------------
# DEBE incluir el parche de php2shell (CVE-2026-109618 / CVE-2026-109619,
# 2026-10-21): 8.2.35 · 8.3.36 · 8.4.27 · 8.5.12
PHP_VERSION=8.4.27
# dev (Xdebug incluido) | prod (sin Xdebug, OPcache inmutable)
PHP_BUILD_TARGET=dev
# 1 = compila APCu (caché en memoria). 0 si PECL no está accesible.
INSTALL_APCU=1
# 1 = muestra los errores de PHP en pantalla (útil al depurar). Sólo dev.
OST_DEBUG=0
# Aviso «el directorio setup/ es accesible» del panel: se comprueba de verdad
# pidiendo /setup/install.php a esta URL (el servicio nginx). Si responde 404
# o 403, el aviso desaparece sin borrar la carpeta (es código versionado).
OST_INTERNAL_URL=http://nginx
# 1 = se da por bloqueado sin comprobar nada (proxy externo, WAF, basic auth).
OST_SETUP_LOCKED=0
# Tema por defecto de la interfaz: auto = sigue al sistema operativo
# (recomendado), dark = oscuro siempre, light = claro siempre. Cada usuario
# puede cambiarlo con el botón de la cabecera y su elección se recuerda.
OST_DEFAULT_THEME=auto
# Densidad inicial: comfy = espaciado original de osTicket, compact = filas y
# formularios mas juntos. El usuario la cambia con el boton de la cabecera.
OST_DEFAULT_DENSITY=comfy
# Correo de administrador que se escribe en ost-config.php antes de instalar
OST_ADMIN_EMAIL=admin@example.com

# --- Puertos del host ------------------------------------------------------
# Si el 8080 está ocupado, cambia el puerto aquí. `make docker-urls` imprime
# las URLs reales y `make docker-up` las muestra al terminar.
HTTP_PORT=8080
DB_PORT=3307
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Base de datos ---------------------------------------------------------
MYSQL_DATABASE=osticket
MYSQL_USER=osticket
MYSQL_PASSWORD=osticket
MYSQL_ROOT_PASSWORD=root
OST_DB_PREFIX=ost_
# 1 = crea la base de datos al arrancar si el volumen ya existía.
# El primer arranque con un volumen vacío no lo necesita (lo hace MariaDB).
OST_INSTALL_DB=0

# --- Aplicación ------------------------------------------------------------
# 32+ caracteres aleatorios. NO reutilices el valor de ejemplo.
OST_SECRET_SALT=
TZ=UTC

# --- Depuración y rendimiento ----------------------------------------------
# develop,debug = F5 funciona en cualquier momento (cómodo, más lento).
# develop       = sin sesiones de depuración: entre 1,5 y 3 veces más rápido.
# off           = máxima velocidad, sin mensajes mejorados de Xdebug.
# Si el proyecto vive en /mnt/d (Windows), deja "develop" y pon "debug" sólo
# mientras depuras. Ver docs/DOCKER.md § 11.
XDEBUG_MODE=develop,debug
XDEBUG_IDE_KEY=VSCODE
# A quién conecta Xdebug: tu equipo, donde escucha VS Code.
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003

# --- Endurecimiento --------------------------------------------------------
# Aborta el arranque si PHP está afectado por php2shell (recomendado: 1)
OST_FAIL_ON_VULNERABLE_PHP=1
# 1 = límites de subida reducidos (sólo si no necesitas adjuntos grandes)
PHP2SHELL_STRICT=0
# Peticiones por worker de PHP-FPM. 1 elimina el estado entre peticiones
# (mitigación de CVE-2026-109619) a costa de rendimiento.
PHP_FPM_MAX_REQUESTS=500
PHP_FPM_MAX_CHILDREN=10

# --- Herramientas del editor (no afecta a los contenedores) ----------------
# Clave de API para .vscode/http/osticket.http (extensión REST Client).
# Créala en el panel: Admin → Manage → API Keys.
OST_KEY=

# --- Propietario de los archivos (Linux) -----------------------------------
# Ajusta a `id -u` / `id -g` para que los archivos generados no sean de root.
PUID=1000
PGID=1000
