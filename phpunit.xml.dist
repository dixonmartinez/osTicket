<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pruebas unitarias (frente 1 de docs/CODE_QUALITY.md).

    composer install          # una vez, para tener PHPUnit y el informe completo
    make unit                 # usa PHPUnit si está; si no, tests/run.php

  Las pruebas no necesitan base de datos ni red: cargan sólo las clases puras
  de include/ con el entorno mínimo de tests/bootstrap.php.

  Un aviso de PHP (deprecación, índice sin definir, conversión obsoleta)
  cuenta como fallo: es un error latente que en la siguiente versión de PHP
  será una excepción. `tests/run.php` hace lo mismo cuando no hay PHPUnit.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="true"
         failOnNotice="true"
         beStrictAboutOutputDuringTests="true">

    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">tests</directory>
            <!-- Las de integración necesitan MariaDB: `make integration` -->
            <exclude>tests/integration</exclude>
        </testsuite>
        <testsuite name="integration">
            <directory suffix="Test.php">tests/integration</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">include</directory>
        </include>
        <exclude>
            <directory>include/pear</directory>
        </exclude>
    </source>
</phpunit>
