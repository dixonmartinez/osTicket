{
  // ---------------------------------------------------------------------
  // Lanzadores de depuración de osTicket
  //
  // No hace falta PHP en tu equipo: el código corre en el contenedor `php`
  // y Xdebug sale hacia host.docker.internal:9003. Requisito: el entorno
  // Docker debe estar arriba (make docker-up).
  //
  //   Petición web   → F5 → "Xdebug: osTicket (web)" y navega a
  //                    http://localhost:8080
  //   Script o test  → F5 → "Xdebug: script CLI (vía Docker)" con el
  //                    archivo abierto en el editor
  //
  // Guía completa: docs/VSCODE.md · Variables de Xdebug: docs/DOCKER.md § 3
  // El puerto 9003 debe estar libre en tu equipo.
  // ---------------------------------------------------------------------
  "version": "0.2.0",
  "configurations": [
    {
      // La que se usa el 99 % del tiempo. Empieza a escuchar en el 9003 y
      // espera a que el contenedor abra una sesión al recibir una petición.
      "name": "Xdebug: osTicket (web)",
      "type": "php",
      "request": "launch",
      "port": 9003,
      "hostname": "0.0.0.0",
      "pathMappings": {
        "/var/www/html": "${workspaceFolder}"
      },
      "xdebugSettings": {
        "max_data": 2048,
        "max_children": 128,
        "max_depth": 4
      },
      "ignore": [
        "**/include/mpdf/**",
        "**/include/laminas-mail/**",
        "**/include/pear/**",
        "**/include/fpdf/**",
        "**/vendor/**"
      ],
      "log": false
    },
    {
      // Igual que la anterior, pero escribe el protocolo de Xdebug en la
      // consola de depuración. Úsala sólo cuando "F5 no se detiene" para
      // ver si el contenedor intenta conectar y con qué ruta.
      "name": "Xdebug: osTicket (web, diagnóstico)",
      "type": "php",
      "request": "launch",
      "port": 9003,
      "hostname": "0.0.0.0",
      "pathMappings": {
        "/var/www/html": "${workspaceFolder}"
      },
      "log": true
    },
    {
      // Scripts de consola (manage.php, tools/*.php) sin PHP en el equipo:
      // el archivo abierto se ejecuta dentro del contenedor con
      // `docker compose exec`. Guarda el archivo antes de pulsar F5.
      "name": "Xdebug: script CLI (vía Docker)",
      "type": "php",
      "request": "launch",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose", "exec", "-T", "php",
        "php",
        "-dxdebug.start_with_request=yes",
        "/var/www/html/${relativeFile}"
      ],
      "cwd": "${workspaceFolder}",
      "port": 9003,
      "hostname": "0.0.0.0",
      "pathMappings": {
        "/var/www/html": "${workspaceFolder}"
      },
      "console": "internalConsole"
    },
    {
      // Suite histórica de osTicket (setup/test). Se ejecuta en el
      // contenedor, con el directorio de trabajo en la raíz del proyecto
      // porque run-tests.php carga ./bootstrap.php.
      "name": "Xdebug: pruebas del proyecto (vía Docker)",
      "type": "php",
      "request": "launch",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose", "exec", "-T", "-w", "/var/www/html",
        "php", "php",
        "-dxdebug.start_with_request=yes",
        "/var/www/html/setup/test/run-tests.php"
      ],
      "cwd": "${workspaceFolder}",
      "port": 9003,
      "hostname": "0.0.0.0",
      "pathMappings": {
        "/var/www/html": "${workspaceFolder}"
      },
      "console": "internalConsole"
    }
  ],
  "compounds": []
}
