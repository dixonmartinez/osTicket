{
  // ---------------------------------------------------------------------
  // Lanzadores de depuración de osTicket
  //
  // Requisito: el entorno Docker debe estar arriba (make docker-up).
  // El Dev Container es OPCIONAL: los mismos lanzadores funcionan con una
  // ventana normal de VS Code, porque Xdebug sale del contenedor hacia
  // host.docker.internal:9003. Ver docs/DOCKER.md § 3.
  //
  //   F5 → "Xdebug: osTicket (Docker)"   y navega a http://localhost:8080
  //   F5 → "Xdebug: depurar script CLI"  para manage.php / tools/*
  //
  // El puerto 9003 debe estar libre en el host.
  // ---------------------------------------------------------------------
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Xdebug: osTicket (Docker)",
      "type": "php",
      "request": "launch",
      "port": 9003,
      "hostname": "0.0.0.0",
      "pathMappings": {
        "/var/www/html": "${workspaceFolder}"
      },
      "xdebugSettings": {
        "max_data": 2048,
        "max_children": 128,
        "max_depth": 4
      },
      "ignore": [
        "**/include/mpdf/**",
        "**/include/laminas-mail/**",
        "**/include/pear/**",
        "**/include/fpdf/**",
        "**/vendor/**"
      ],
      "log": false
    },
    {
      "name": "Xdebug: osTicket (Docker, esperar conexión)",
      "type": "php",
      "request": "launch",
      "port": 9003,
      "hostname": "0.0.0.0",
      "pathMappings": {
        "/var/www/html": "${workspaceFolder}"
      },
      "ignore": [
        "**/include/mpdf/**",
        "**/include/laminas-mail/**",
        "**/include/pear/**",
        "**/include/fpdf/**",
        "**/vendor/**"
      ]
    },
    {
      // Sólo útil dentro del contenedor (Dev Containers), donde existe el
      // binario /usr/local/bin/php. En Windows sin PHP usa la variante Docker.
      "name": "Xdebug: script CLI (dentro del contenedor)",
      "type": "php",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "port": 9003,
      "hostname": "0.0.0.0",
      "pathMappings": {
        "/var/www/html": "${workspaceFolder}"
      },
      "runtimeArgs": ["-dxdebug.start_with_request=yes"],
      "env": {
        "XDEBUG_MODE": "debug,develop"
      },
      "console": "internalConsole"
    },
    {
      // Funciona desde Windows/macOS/Linux sin PHP instalado: el script se
      // ejecuta dentro del contenedor con `docker compose exec`.
      "name": "Xdebug: script CLI (desde el host, vía Docker)",
      "type": "php",
      "request": "launch",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose", "exec", "-T", "php",
        "php",
        "-dxdebug.start_with_request=yes",
        "-dxdebug.client_host=host.docker.internal",
        "/var/www/html/${relativeFile}"
      ],
      "port": 9003,
      "hostname": "0.0.0.0",
      "pathMappings": {
        "/var/www/html": "${workspaceFolder}"
      },
      "console": "internalConsole"
    },
    {
      "name": "Xdebug: pruebas del proyecto (setup/test)",
      "type": "php",
      "request": "launch",
      "program": "${workspaceFolder}/setup/test/run-tests.php",
      "cwd": "${workspaceFolder}",
      "port": 9003,
      "hostname": "0.0.0.0",
      "pathMappings": {
        "/var/www/html": "${workspaceFolder}"
      },
      "console": "internalConsole"
    }
  ],
  "compounds": []
}
