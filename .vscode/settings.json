{
    // ---------------------------------------------------------------------
    // Ajustes compartidos del equipo (no específicos de la máquina).
    // Los personales van en .vscode/settings.local.json (en .gitignore).
    // ---------------------------------------------------------------------

    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.associations": {
        "*.inc.php": "php",
        "*.tmpl.php": "php",
        "compose.yaml": "yaml",
        "compose.override.yaml": "yaml"
    },
    "files.watcherExclude": {
        "**/include/mpdf/**": true,
        "**/include/laminas-mail/**": true,
        "**/include/pear/**": true,
        "**/vendor/**": true,
        "**/node_modules/**": true,
        "**/include/i18n/**": true
    },
    "search.exclude": {
        "**/include/mpdf/**": true,
        "**/include/laminas-mail/**": true,
        "**/include/pear/**": true,
        "**/include/fpdf/**": true,
        "**/vendor/**": true,
        "**/assets/**/*.min.*": true
    },

    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [80, 120],
    "editor.formatOnSave": false,
    // `files.eol` repetido por lenguaje a propósito: un ajuste de lenguaje
    // del usuario (`"[php]": { "files.eol": "\r\n" }`) gana al `files.eol`
    // general del proyecto, y no al de lenguaje del proyecto. Era la vía por
    // la que `ajax.php` e `index.php` volvían a CRLF cada vez que se
    // guardaban, y lo que hacía fallar EntryPointTest.
    "[php]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "files.eol": "\n",
        "files.insertFinalNewline": true
    },
    "[shellscript]": {
        "files.eol": "\n",
        "files.insertFinalNewline": true
    },
    "[json]": { "editor.tabSize": 2, "files.eol": "\n" },
    "[jsonc]": { "editor.tabSize": 2, "files.eol": "\n" },
    "[yaml]": { "editor.tabSize": 2, "files.eol": "\n" },
    "[markdown]": { "editor.tabSize": 2, "files.eol": "\n" },

    // PHP
    "intelephense.environment.phpVersion": "8.4.0",
    "intelephense.files.maxSize": 3000000,
    "intelephense.files.exclude": [
        "**/include/mpdf/**",
        "**/include/laminas-mail/**",
        "**/include/pear/**",
        "**/include/fpdf/**",
        "**/vendor/**"
    ],
    "intelephense.stubs": [
        "Core", "standard", "mysqli", "gd", "gettext",
        "mbstring", "intl", "zip", "json", "session", "phar"
    ],
    // No hay PHP en el equipo a propósito (todo corre en contenedores): la
    // validación la hace Intelephense y la ejecución va por `docker compose`.
    // Ver docs/VSCODE.md.
    "php.validate.enable": false,

    // Evita que el editor marque los archivos de terceros
    "files.exclude": {
        "**/.git": true,
        "**/vendor": false
    },

    "terminal.integrated.env.linux": {
        "COMPOSE_PROJECT_NAME": "osticket"
    }
}
