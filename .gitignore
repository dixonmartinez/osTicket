.htaccess
php53.cgi
include/ost-config.php
setup/cli/modules/importer
*.sw[a-z]
.DS_Store
.vagrant
._.DS_Store
Vagrantfile
# VS Code workspace files
*.code-workspace

# Staging directory used for packaging script
stage

# Ignore packaged plugins and language packs
*.phar

# Ignore mPDF temp files
include/mpdf/ttfontdata
include/mpdf/tmp
nbproject/

# Dependencias de desarrollo (Composer)
/vendor/
.phpunit.result.cache
.phpstan-cache

# Entorno local de Docker (credenciales)
/.env

# Ajustes locales de VS Code
.vscode/settings.local.json

# Secretos locales (REST Client lee OST_KEY del .env de la raíz)
.vscode/http/.env

# Hoja de iconos generada por `make icons`
ost-iconos.html

# Caché de PHPUnit
.phpunit.cache/
.phpunit.result.cache

# Manifiesto del sembrador de datos de demostración (se genera solo)
tools/dev/seed-manifest.json

# Copias temporales que generan las herramientas al ejecutarse sin el
# guardian de linea de comandos (php-wasm, pruebas locales). No son codigo.
tools/ui/.*-noguard.php
tests/.run-wasm.php
