<?xml version="1.0"?>
<!--
  Estándar mínimo para código nuevo.

  Deliberadamente limitado a tools/ (código nuevo) para no generar miles de
  avisos del código histórico. Al migrar módulos, añade su ruta a <file>.
-->
<ruleset name="osTicket (nuevo)">
    <description>Convenciones para código nuevo en osTicket</description>

    <file>tools</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- Los mensajes de usuario pasan por gettext (__()/__S()) -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
