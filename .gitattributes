# ---------------------------------------------------------------------------
# Finales de línea
#
# El repositorio de osTicket mezcla LF y CRLF: hay 29 archivos de texto
# heredados guardados con CRLF (api/index.php, css/flags.css, include/index.php,
# include/PasswordHash.php, include/i18n/langs.php, include/i18n/vendor/redactor,
# include/pear/Crypt/*, include/staff/*.inc.php, kb/index.php, scp/js/tips.js,
# tickets.php…).
#
# Declarar `* text=auto` los marcaría como modificados en cada `git status`
# aunque nadie los toque: git compara la versión normalizada a LF con el blob
# que sigue en CRLF. Por eso el valor por defecto es `-text`: git no convierte
# nada y el árbol de trabajo queda byte a byte igual al repositorio.
#
# Sólo se fuerza LF donde un CRLF rompe la ejecución dentro del contenedor.
# ---------------------------------------------------------------------------

* -text

# Un .sh con CRLF falla en Linux con "bad interpreter: /bin/sh^M".
*.sh             text eol=lf
*.bash           text eol=lf
Dockerfile       text eol=lf
*.conf           text eol=lf
*.sql            text eol=lf
Makefile         text eol=lf
.gitattributes   text eol=lf
.editorconfig    text eol=lf

# Configuración que sólo mantenemos nosotros (no hay heredados con CRLF)
*.yaml           text eol=lf
*.yml            text eol=lf
*.json           text eol=lf
*.ini            text eol=lf

# Binarios: nunca normalizar
*.png            binary
*.jpg            binary
*.jpeg           binary
*.gif            binary
*.ico            binary
*.webp           binary
*.woff           binary
*.woff2          binary
*.ttf            binary
*.otf            binary
*.eot            binary
*.pdf            binary
*.zip            binary
*.phar           binary
